# ============================================================
# SafeDeploy — Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs.
# NE JAMAIS versionner le fichier .env réel.
# ============================================================

# --- PostgreSQL ---
# Nom de la base de données principale
POSTGRES_DB=safedeploy

# Utilisateur PostgreSQL (non-root)
POSTGRES_USER=safeuser

# Mot de passe PostgreSQL — changez cette valeur dans .env
POSTGRES_PASSWORD=changeme

# Port exposé sur la machine hôte (interne Docker : 5432)
POSTGRES_PORT=5432

# --- MLflow ---
# Port exposé sur la machine hôte
MLFLOW_PORT=5000

# URI du backend de tracking SQLite (chemin interne au conteneur)
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db

# Dossier des artefacts (chemin interne au conteneur)
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts

# --- Backend FastAPI (S2) ---
BACKEND_PORT=8000

# URL interne Docker vers MLflow (utilisée par le backend et le trainer)
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Frontend Next.js (S3) ---
FRONTEND_PORT=3000

# URL appelée par le navigateur pour joindre le backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL utilisée par Next.js côté serveur (nom de service Docker)
INTERNAL_API_URL=http://backend:8000

# --- Prometheus (S5) ---
PROMETHEUS_PORT=9090

# --- Grafana (S5) ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Mot de passe Grafana — changez cette valeur dans .env
GRAFANA_ADMIN_PASSWORD=changeme
