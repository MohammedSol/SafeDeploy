__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
# Note : lib/ Python exclue, mais pas frontend/src/lib (TypeScript)
*.egg-link
lib64/
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# --- Node / Next.js ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# --- Docker ---
# Volumes Docker montés localement (si dev)
mlflow_data/
postgres_data/

# --- Données brutes et modèles locaux ---
backend/data/sales.csv
mlruns/
mlflow.db
*.pkl
*.joblib

